<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rogério | Portfólio de Sistemas & IA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background-color: #fafcfd; color: #1a2c33; line-height: 1.5; overflow-x: hidden; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
    
    /* ANIMAÇÕES GLOBAIS */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(40px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeInLeft {
      from { opacity: 0; transform: translateX(-40px); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes fadeInRight {
      from { opacity: 0; transform: translateX(40px); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.9); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes pulseGlow {
      0% { box-shadow: 0 0 0 0 rgba(27,107,135,0.4); }
      70% { box-shadow: 0 0 0 12px rgba(27,107,135,0); }
      100% { box-shadow: 0 0 0 0 rgba(27,107,135,0); }
    }
    @keyframes float {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-8px); }
      100% { transform: translateY(0px); }
    }
    @keyframes rotateIcon {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes slideInDown {
      from { opacity: 0; transform: translateY(-30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .animate-fadeUp { animation: fadeInUp 0.7s ease forwards; }
    .animate-fadeLeft { animation: fadeInLeft 0.7s ease forwards; }
    .animate-fadeRight { animation: fadeInRight 0.7s ease forwards; }
    .animate-scale { animation: scaleIn 0.6s ease forwards; }
    .animate-float { animation: float 4s ease-in-out infinite; }
    
    .navbar { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 0; flex-wrap: wrap; gap: 1rem; border-bottom: 1px solid #e2edf2; animation: slideInDown 0.6s ease; }
    .logo { font-size: 1.6rem; font-weight: 800; background: linear-gradient(135deg, #0f2b3d, #1b6b87); background-clip: text; -webkit-background-clip: text; color: transparent; cursor: pointer; transition: transform 0.3s; display: inline-block; }
    .logo:hover { transform: scale(1.05); }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a { text-decoration: none; font-weight: 500; color: #2c3e44; transition: all 0.3s; cursor: pointer; position: relative; }
    .nav-links a::after { content: ''; position: absolute; bottom: -5px; left: 0; width: 0%; height: 2px; background: #1b6b87; transition: width 0.3s ease; }
    .nav-links a:hover::after, .nav-links a.active::after { width: 100%; }
    .nav-links a:hover, .nav-links a.active { color: #1b6b87; }
    
    section { padding: 4rem 0; }
    .section-title { font-size: 2rem; font-weight: 700; text-align: center; margin-bottom: 2.5rem; color: #0f2b3d; opacity: 0; animation: fadeInUp 0.7s ease forwards; }
    .section-title span { background: linear-gradient(135deg, #1b6b87, #0f4f66); background-clip: text; -webkit-background-clip: text; color: transparent; }
    
    .hero { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 3rem; padding: 2rem 0; }
    .hero-content { flex: 1; min-width: 280px; opacity: 0; animation: fadeInLeft 0.8s ease forwards; }
    .hero-badge { display: inline-block; background: #e4f0f5; padding: 0.3rem 1rem; border-radius: 40px; font-size: 0.85rem; font-weight: 600; color: #0f5c77; margin-bottom: 1.2rem; transition: all 0.3s; }
    .hero-badge:hover { transform: translateX(5px); background: #d4eaf0; }
    .hero-content h1 { font-size: 3rem; font-weight: 800; line-height: 1.2; margin-bottom: 1rem; }
    .hero-content h1 .highlight { color: #1b6b87; position: relative; display: inline-block; }
    .hero-content h1 .highlight::before { content: ''; position: absolute; bottom: 5px; left: 0; width: 100%; height: 8px; background: rgba(27,107,135,0.2); z-index: -1; border-radius: 4px; }
    .hero-content p { font-size: 1.1rem; color: #4a5b62; margin-bottom: 1.8rem; max-width: 540px; }
    .social-links-hero { display: flex; gap: 1rem; margin-bottom: 1.8rem; flex-wrap: wrap; }
    .social-links-hero a { font-size: 1.5rem; color: #376e82; transition: all 0.3s; display: inline-block; }
    .social-links-hero a:hover { color: #1b6b87; transform: translateY(-5px) scale(1.1); }
    .btn-primary { background: #1b6b87; color: white; border: none; padding: 0.8rem 2rem; border-radius: 40px; font-weight: 600; font-size: 1rem; cursor: pointer; transition: all 0.3s; display: inline-flex; align-items: center; gap: 0.5rem; }
    .btn-primary:hover { background: #0f4f66; transform: translateY(-3px); box-shadow: 0 8px 20px rgba(27,107,135,0.3); gap: 0.8rem; }
    .btn-outline { border: 1.5px solid #1b6b87; background: transparent; padding: 0.7rem 1.8rem; border-radius: 40px; font-weight: 600; color: #1b6b87; cursor: pointer; transition: all 0.3s; margin-left: 0.8rem; }
    .btn-outline:hover { background: #1b6b87; color: white; transform: translateY(-3px); box-shadow: 0 5px 15px rgba(27,107,135,0.2); }
    .hero-image { flex: 1; min-width: 260px; text-align: center; opacity: 0; animation: fadeInRight 0.8s ease forwards; }
    .hero-image img { max-width: 100%; height: auto; border-radius: 1rem; box-shadow: 0 20px 35px rgba(0,0,0,0.1); transition: transform 0.4s, box-shadow 0.4s; }
    .hero-image img:hover { transform: scale(1.02) translateY(-5px); box-shadow: 0 25px 40px rgba(0,0,0,0.15); }
    
    .about-section { background: linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.75)), url('https://images.unsplash.com/photo-1620712943543-bcc4688e7485?w=1200&h=600&fit=crop'); background-size: cover; background-position: center; background-attachment: fixed; border-radius: 2rem; margin: 2rem 0 0 0; padding: 4rem 3rem; box-shadow: 0 15px 35px rgba(0,0,0,0.2); opacity: 0; animation: fadeInUp 0.9s ease forwards; animation-delay: 0.2s; }
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
    .about-content h3 { font-size: 2rem; margin-bottom: 1.5rem; color: white; display: flex; align-items: center; gap: 0.8rem; }
    .about-content h3 i { color: #5bc0de; font-size: 2rem; transition: transform 0.3s; }
    .about-content h3:hover i { transform: rotate(10deg) scale(1.1); }
    .about-content p { color: #e8e8e8; margin-bottom: 1.2rem; line-height: 1.7; font-size: 1rem; transition: transform 0.3s, padding-left 0.3s; }
    .about-content p:hover { transform: translateX(5px); }
    .about-content p strong { color: #5bc0de; font-weight: 600; }
    .about-icon { text-align: center; animation: float 5s ease-in-out infinite; }
    .about-icon i { font-size: 9rem; color: rgba(255,255,255,0.95); filter: drop-shadow(0 5px 15px rgba(0,0,0,0.3)); transition: transform 0.3s; }
    .about-icon i:hover { transform: scale(1.05); animation: rotateIcon 0.6s ease; }
    
    .portfolio-redirect { background: linear-gradient(135deg, #eef3f8, #e4f0f5); border-radius: 2rem; padding: 3rem; text-align: center; margin: 2rem 0; transition: all 0.4s; opacity: 0; animation: scaleIn 0.7s ease forwards; }
    .portfolio-redirect:hover { transform: translateY(-5px); box-shadow: 0 20px 35px rgba(0,0,0,0.1); }
    .portfolio-redirect h2 { font-size: 2rem; margin-bottom: 1rem; color: #0f2b3d; }
    .portfolio-redirect p { color: #4a5b62; margin-bottom: 2rem; max-width: 600px; margin-left: auto; margin-right: auto; }
    .btn-portfolio-externo { background: linear-gradient(135deg, #1b6b87, #0f4f66); color: white; border: none; padding: 1rem 2.5rem; border-radius: 50px; font-weight: 700; font-size: 1.1rem; cursor: pointer; transition: all 0.4s; display: inline-flex; align-items: center; gap: 0.8rem; box-shadow: 0 8px 20px rgba(27,107,135,0.3); }
    .btn-portfolio-externo:hover { transform: translateY(-4px) scale(1.02); box-shadow: 0 15px 30px rgba(27,107,135,0.4); gap: 1.2rem; }
    
    .contact-container { max-width: 800px; margin: 0 auto; }
    .contact-info-card { background: #eef3f8; padding: 2.5rem; border-radius: 1.5rem; text-align: center; transition: all 0.4s; opacity: 0; animation: fadeInUp 0.8s ease forwards; }
    .contact-info-card:hover { transform: translateY(-8px); box-shadow: 0 20px 35px rgba(0,0,0,0.1); }
    .contact-detail { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 1.5rem; padding: 0.8rem; border-radius: 1rem; transition: all 0.3s; flex-wrap: wrap; }
    .contact-detail:hover { background: rgba(27,107,135,0.08); transform: translateX(5px); }
    .contact-detail i { font-size: 1.5rem; color: #1b6b87; width: 45px; transition: transform 0.3s; }
    .contact-detail:hover i { transform: scale(1.15) rotate(5deg); }
    .btn-copy { background: transparent; border: 1px solid #cbdde5; padding: 0.3rem 0.8rem; border-radius: 30px; font-size: 0.75rem; cursor: pointer; transition: all 0.3s; }
    .btn-copy:hover { background: #1b6b87; color: white; border-color: #1b6b87; transform: scale(1.05); }
    .map-placeholder { margin-top: 1.5rem; background: linear-gradient(135deg, #c2dfea, #aaccdb); border-radius: 1rem; padding: 1.5rem; text-align: center; color: #0f4f66; font-size: 0.85rem; transition: all 0.3s; }
    .map-placeholder:hover { transform: scale(1.02); box-shadow: 0 8px 20px rgba(0,0,0,0.1); }
    .social-contact { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #cbdde5; }
    .social-icons-contact { display: flex; justify-content: center; gap: 1.5rem; }
    .social-icons-contact a { font-size: 1.8rem; color: #376e82; transition: all 0.3s; display: inline-block; }
    .social-icons-contact a:hover { color: #1b6b87; transform: translateY(-5px) scale(1.1); }
    
    footer { background: #0f2b38; color: #cbdde5; padding: 2rem 0; text-align: center; margin-top: 3rem; transition: all 0.3s; }
    footer p { transition: transform 0.3s; }
    footer p:hover { transform: translateY(-2px); letter-spacing: 0.5px; }
    
    .config-panel { background: white; border-radius: 1rem; padding: 1rem; margin-bottom: 1rem; border: 1px solid #cde3ec; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; justify-content: center; opacity: 0; animation: fadeInUp 0.6s ease forwards; }
    .config-panel input { flex: 1; min-width: 250px; padding: 0.8rem 1rem; border: 1.5px solid #e2edf2; border-radius: 1rem; font-family: inherit; font-size: 0.9rem; transition: all 0.3s; }
    .config-panel input:focus { outline: none; border-color: #1b6b87; box-shadow: 0 0 0 3px rgba(27,107,135,0.2); transform: scale(1.01); }
    .config-panel button { background: #1b6b87; color: white; border: none; padding: 0.8rem 1.5rem; border-radius: 2rem; font-weight: 600; cursor: pointer; transition: all 0.3s; }
    .config-panel button:hover { background: #0f4f66; transform: scale(1.02); box-shadow: 0 4px 12px rgba(27,107,135,0.3); animation: pulseGlow 1.2s infinite; }
    
    @media (max-width: 800px) {
      .navbar { flex-direction: column; align-items: flex-start; }
      .hero-content h1 { font-size: 2rem; }
      .btn-outline { margin-left: 0; margin-top: 0.5rem; }
      .hero-buttons { display: flex; flex-direction: column; gap: 0.8rem; }
      .contact-detail { flex-direction: column; text-align: center; }
      .about-grid { grid-template-columns: 1fr; text-align: center; }
      .about-section { padding: 2rem; background-attachment: scroll; }
      .about-content h3 { justify-content: center; font-size: 1.5rem; }
    }
  </style>
</head>
<body>

  <div class="container">
    <nav class="navbar">
      <div class="logo" id="logoName" onclick="showSection('home')">Rogério.dev</div>
      <ul class="nav-links">
        <li><a class="nav-link active" data-section="home" onclick="showSection('home')">Início</a></li>
        <li><a class="nav-link" data-section="portfolio" onclick="showSection('portfolio')">Portfólio</a></li>
        <li><a class="nav-link" data-section="contact" onclick="showSection('contact')">Contato</a></li>
      </ul>
    </nav>
  </div>

  <section id="home-section">
    <div class="container">
      <div class="hero">
        <div class="hero-content">
          <span class="hero-badge"><i class="fas fa-microchip"></i> <span id="heroBadge">Desenvolvedor de Sistemas & IA</span></span>
          <h1>Olá, eu sou <span class="highlight" id="heroName">Rogério</span></h1>
          <p id="heroDescription">Especialista em desenvolvimento de sistemas inteligentes e soluções com Inteligência Artificial. Transformo dados em decisões e ideias em software de alto impacto.</p>
          <div class="social-links-hero" id="socialLinks"></div>
          <div class="hero-buttons">
            <button class="btn-primary" onclick="showSection('portfolio')">Ver Portfólio <i class="fas fa-arrow-right"></i></button>
            <button class="btn-outline" onclick="showSection('contact')">Contato <i class="fas fa-envelope"></i></button>
          </div>
        </div>
        <div class="hero-image">
          <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=400&h=400&fit=crop" alt="Rogério - Desenvolvedor de Sistemas" onerror="this.src='https://placehold.co/400x400/1b6b87/white?text=Rogerio'">
        </div>
      </div>

      <div class="about-section">
        <div class="about-grid">
          <div class="about-content">
            <h3><i class="fas fa-brain"></i> Desenvolvimento de Sistemas & Inteligência Artificial</h3>
            <p>Com mais de <strong>5 anos de experiência</strong> em desenvolvimento de software, me especializei na criação de <strong>sistemas escaláveis</strong> e <strong>soluções inteligentes</strong> que utilizam Inteligência Artificial para resolver problemas reais do mercado.</p>
            <p>Atuo desde o levantamento de requisitos até a implementação de modelos de Machine Learning, passando por arquitetura de sistemas, APIs robustas e integração com bancos de dados. Acredito que a tecnologia deve ser usada para automatizar processos, gerar insights e criar experiências excepcionais.</p>
            <p>Tenho experiência em projetos que envolvem <strong>Processamento de Linguagem Natural (NLP)</strong>, <strong>Visão Computacional</strong>, <strong>Sistemas de Recomendação</strong> e <strong>Chatbots Inteligentes</strong>, sempre buscando entregar valor real para os usuários e negócios.</p>
          </div>
          <div class="about-icon">
            <i class="fas fa-robot"></i>
            <p style="margin-top: 1rem; font-size: 1rem; color: rgba(255,255,255,0.9); font-weight: 500;">Machine Learning | Deep Learning | LLMs</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="portfolio-section" style="display: none;">
    <div class="container">
      <div class="config-panel">
        <i class="fas fa-link" style="color: #1b6b87;"></i>
        <input type="text" id="portfolioLinkInput" placeholder="Cole aqui o link do seu portfólio (ex: https://meusite.com/portfolio)">
        <button id="saveLinkBtn">Salvar Link</button>
      </div>
      
      <div class="portfolio-redirect">
        <i class="fas fa-folder-open" style="font-size: 4rem; color: #1b6b87; margin-bottom: 1rem; display: block;"></i>
        <h2>Meu Portfólio Completo</h2>
        <p>Confira todos os meus projetos, trabalhos e cases de sucesso. Desenvolvimento de sistemas, Inteligência Artificial, Machine Learning e muito mais!</p>
        <button class="btn-portfolio-externo" id="externalPortfolioBtn">
          <i class="fas fa-external-link-alt"></i> Acessar Portfólio Completo
        </button>
      </div>
    </div>
  </section>

  <section id="contact-section" style="display: none;">
    <div class="container">
      <h2 class="section-title">Vamos <span>Conversar</span></h2>
      <div class="contact-container">
        <div class="contact-info-card" id="contactInfoCard"></div>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      <p id="footerText">© 2025 Rogério — Desenvolvedor de Sistemas & IA</p>
    </div>
  </footer>

  <script>
    let linkSalvo = localStorage.getItem("meuLinkPortfolio") || "";

    function showToast(message) {
      const toast = document.createElement('div');
      toast.style.position = 'fixed';
      toast.style.bottom = '20px';
      toast.style.right = '20px';
      toast.style.background = '#1b6b87';
      toast.style.color = 'white';
      toast.style.padding = '0.8rem 1.5rem';
      toast.style.borderRadius = '40px';
      toast.style.fontSize = '0.85rem';
      toast.style.zIndex = '1000';
      toast.style.animation = 'fadeInOut 2s ease';
      toast.innerText = message;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 2000);
    }

    const styleAnim = document.createElement('style');
    styleAnim.textContent = `
      @keyframes fadeInOut {
        0% { opacity: 0; transform: translateY(20px); }
        15% { opacity: 1; transform: translateY(0); }
        85% { opacity: 1; transform: translateY(0); }
        100% { opacity: 0; transform: translateY(20px); }
      }
    `;
    document.head.appendChild(styleAnim);

    function aplicarDados() {
      document.getElementById('heroBadge').innerText = "Desenvolvedor de Sistemas & IA";
      document.getElementById('heroName').innerText = "Rogério";
      document.getElementById('heroDescription').innerText = "Especialista em desenvolvimento de sistemas inteligentes e soluções com Inteligência Artificial. Transformo dados em decisões e ideias em software de alto impacto.";
      document.getElementById('footerText').innerHTML = `© 2025 Rogério — Desenvolvedor de Sistemas & IA`;
      
      const logoElem = document.getElementById('logoName');
      if(logoElem) logoElem.innerText = "Rogério.dev";

      const socialContainer = document.getElementById('socialLinks');
      socialContainer.innerHTML = `
        <a href="https://github.com/rogerio" target="_blank"><i class="fab fa-github"></i></a>
        <a href="https://linkedin.com/in/rogerio" target="_blank"><i class="fab fa-linkedin-in"></i></a>
        <a href="https://instagram.com/rogerio.dev" target="_blank"><i class="fab fa-instagram"></i></a>
        <a href="https://twitter.com/rogerio_ia" target="_blank"><i class="fab fa-twitter"></i></a>
      `;

      const externalBtn = document.getElementById('externalPortfolioBtn');
      if (externalBtn) {
        externalBtn.addEventListener('click', () => {
          if (linkSalvo && linkSalvo !== "") {
            window.open(linkSalvo, '_blank');
          } else {
            showToast("📌 Cole seu link no campo acima e clique em 'Salvar Link' primeiro!");
          }
        });
      }

      const saveBtn = document.getElementById('saveLinkBtn');
      const inputField = document.getElementById('portfolioLinkInput');
      
      if (saveBtn && inputField) {
        if (linkSalvo) {
          inputField.value = linkSalvo;
        }
        saveBtn.addEventListener('click', () => {
          let novoLink = inputField.value.trim();
          if (novoLink && (novoLink.startsWith('http://') || novoLink.startsWith('https://'))) {
            linkSalvo = novoLink;
            localStorage.setItem("meuLinkPortfolio", linkSalvo);
            showToast("✅ Link salvo com sucesso! Agora clique em 'Acessar Portfólio Completo'");
          } else if (novoLink) {
            showToast("⚠️ O link deve começar com http:// ou https://");
          } else {
            showToast("⚠️ Digite um link válido");
          }
        });
      }

      const email = "rogerio@devia.com";
      const whatsapp = "5511987654321";
      const whatsappLink = `https://wa.me/${whatsapp}`;
      
      const contactCard = document.getElementById('contactInfoCard');
      contactCard.innerHTML = `
        <h3><i class="fas fa-address-card"></i> Meus Contatos</h3>
        <div class="contact-detail"><i class="fas fa-envelope"></i><p><strong>Email:</strong> <a href="mailto:${email}">${email}</a></p><button class="btn-copy" data-copy="${email}">Copiar</button></div>
        <div class="contact-detail"><i class="fab fa-whatsapp"></i><p><strong>WhatsApp:</strong> <a href="${whatsappLink}" target="_blank">(11) 98765-4321</a></p><button class="btn-copy" data-copy="(11) 98765-4321">Copiar</button></div>
        <div class="contact-detail"><i class="fab fa-instagram"></i><p><strong>Instagram:</strong> <a href="https://instagram.com/rogerio.dev" target="_blank">@rogerio.dev</a></p></div>
        <div class="contact-detail"><i class="fab fa-github"></i><p><strong>GitHub:</strong> <a href="https://github.com/rogerio" target="_blank">github.com/rogerio</a></p></div>
        <div class="contact-detail"><i class="fab fa-linkedin-in"></i><p><strong>LinkedIn:</strong> <a href="https://linkedin.com/in/rogerio" target="_blank">linkedin.com/in/rogerio</a></p></div>
        <div class="contact-detail"><i class="fas fa-map-marker-alt"></i><p>Arapongas PR - Brasil</p></div>
        <div class="map-placeholder"><i class="fas fa-map-pin"></i><p>📍 Arapongas PR - Brasil</p><small>Atendo remotamente em todo Brasil 🌎</small></div>
        <div class="social-contact"><h4>Redes Sociais</h4><div class="social-icons-contact"><a href="https://github.com/rogerio" target="_blank"><i class="fab fa-github"></i></a><a href="https://linkedin.com/in/rogerio" target="_blank"><i class="fab fa-linkedin-in"></i></a><a href="https://instagram.com/rogerio.dev" target="_blank"><i class="fab fa-instagram"></i></a><a href="https://twitter.com/rogerio_ia" target="_blank"><i class="fab fa-twitter"></i></a></div></div>
      `;

      document.querySelectorAll('.btn-copy').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const textToCopy = btn.getAttribute('data-copy');
          navigator.clipboard.writeText(textToCopy);
          showToast(`✅ ${textToCopy} copiado!`);
        });
      });
    }

    const sections = {
      home: document.getElementById('home-section'),
      portfolio: document.getElementById('portfolio-section'),
      contact: document.getElementById('contact-section')
    };

    function showSection(sectionId) {
      Object.values(sections).forEach(sec => { if (sec) sec.style.display = 'none'; });
      if (sections[sectionId]) sections[sectionId].style.display = 'block';
      document.querySelectorAll('.nav-link').forEach(link => {
        if (link.getAttribute('data-section') === sectionId) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
      
      // Adiciona animação sutil ao trocar de seção
      const activeSection = sections[sectionId];
      if(activeSection) {
        activeSection.style.opacity = '0';
        setTimeout(() => { activeSection.style.opacity = '1'; }, 50);
      }
    }

    window.showSection = showSection;
    aplicarDados();
    showSection('home');
  </script>
</body>
</html>  